# .env.example
# Copy to .env and adjust. Never commit .env.!!

# --- Postgres ---
POSTGRES_USER=recall
POSTGRES_PASSWORD=recall_dev_password
POSTGRES_DB=recall
# Host port. 5432 is taken by a native Postgres install, so we publish on 5433.
POSTGRES_HOST_PORT=5433

# Connection string used by the backend running on the host (not in Docker).
DATABASE_URL=postgresql+asyncpg://recall:recall_dev_password@localhost:5433/recall

# --- Redis ---
REDIS_HOST_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
# Origin allowed to call the API from the browser (the Next.js dev server).
CORS_ORIGINS=http://localhost:3000

# --- Providers (Phase 2+; leave blank for now) ---
OPENAI_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
